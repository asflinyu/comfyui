{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "S2V Console (F5 调试，无重载)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}",
            "python": "/root/miniconda3/envs/bmc/bin/python",
            "args": [
                "app:app",
                "--host", "0.0.0.0",
                "--port", "6010"
            ],
            "env": {
                "PYTHONPATH": "/root/ComfyUI/s2v_console_v2",
                "PYTHONUNBUFFERED": "1"
            },
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": true,
            "preLaunchTask": "ensure-tts"
        },
        {
            "name": "S2V Console (带重载，开发用)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}",
            "python": "/root/miniconda3/envs/bmc/bin/python",
            "args": [
                "app:app",
                "--host", "0.0.0.0",
                "--port", "6010",
                "--reload"
            ],
            "env": {
                "PYTHONPATH": "/root/ComfyUI/s2v_console_v2",
                "PYTHONUNBUFFERED": "1"
            },
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": true,
            "preLaunchTask": "ensure-tts"
        }
    ]
}

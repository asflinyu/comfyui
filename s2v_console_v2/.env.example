# 写分镜用，填一个即可。有 Moonshot 会优先。
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2.7-code-highspeed

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ComfyUI / TTS。AutoDL 公网请开 6008（nginx → 控制台 6010），不要把 TTS 绑到 6008。
COMFY_URL=http://127.0.0.1:6006
TTS_URL=http://127.0.0.1:6009

# 控制台监听地址（前端所有操作都走这一个端口）
CONSOLE_HOST=0.0.0.0
CONSOLE_PORT=6010
